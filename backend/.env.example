# Postgres connection string from Railway (Variables tab on the Postgres service)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Any long random string — used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the server listens on (Railway sets this automatically in production)
PORT=8080

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:8000
